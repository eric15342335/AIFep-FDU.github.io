{
  "providers": {
    "local": {
      "baseUrl": "http://litellm:4000/v1",
      "api": "openai-completions",
      "apiKey": "none",
      "headers": { "x-litellm-tags": "$TABLEQA_TAG" },
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": true,
        "supportsStore": false,
        "maxTokensField": "max_tokens",
        "thinkingFormat": "qwen"
      },
      "models": [
        {
          "id": "set-by-entrypoint",
          "name": "set-by-entrypoint",
          "reasoning": true,
          "thinkingLevelMap": {
            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "xhigh"
          },
          "input": ["text", "image"],
          "contextWindow": 262144,
          "maxTokens": 65536,
          "samplingParams": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "preserve_thinking": true,
            "vl_high_resolution_images": true
          },
          "samplingParamsByThinkingLevel": { "off": { "temperature": 0.7, "top_p": 0.8 } }
        },
        {
          "id": "qwen4-max",
          "name": "qwen4-max",
          "reasoning": true,
          "thinkingLevelMap": {
            "minimal": "low",
            "low": "low",
            "medium": "high",
            "high": "xhigh"
          },
          "input": ["text", "image"],
          "contextWindow": 262144,
          "maxTokens": 65536,
          "samplingParams": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "presence_penalty": 0.0,
            "preserve_thinking": true
          },
          "samplingParamsByThinkingLevel": {
            "off": { "temperature": 0.7, "top_p": 0.8, "presence_penalty": 1.5 }
          }
        }
      ]
    }
  }
}
