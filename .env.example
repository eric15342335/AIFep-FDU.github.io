# 在阿里云 ECS / PAI-DSW 环境配置。不要将真实 API Key 提交到代码库。
export DASHSCOPE_API_KEY='填入百炼API_Key'
# 从控制台复制完整 OpenAI 兼容地址，并与 API Key 的业务空间、地域保持一致。
export DASHSCOPE_BASE_URL='https://业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1'

# Agent 实验：经 LiteLLM 网关调用上面的百炼地址。网关只转发这一个模型名。
export AGENT_MODEL='qwen3.8-flash'

# 可选：上游服务里的模型名（默认与 AGENT_MODEL 相同；本地测试服务器可能不同）。
# export DASHSCOPE_MODEL='qwen3.8-flash'
# 可选：Phoenix 只记录耗时和 token，不记录消息全文（并发很高时使用）。
# export PHOENIX_HIDE_MESSAGES='true'
