%%{init: {"theme": "base", "themeVariables": {"fontSize": "17px", "lineColor": "#64748b", "primaryTextColor": "#0f172a", "edgeLabelBackground": "#ffffff"}, "flowchart": {"nodeSpacing": 22, "rankSpacing": 30, "padding": 10, "wrappingWidth": 240, "subGraphTitleMargin": {"top": 4, "bottom": 10}}}}%%
%% Compact Chinese version of question-states.mmd for the course report (docs/report/report.md).
flowchart TB
    subgraph SESSION["<b>沙箱内：一次智能体会话</b>"]
        direction TB
        turn(["模型回合：调用一次模型"])
        what{{"模型做了什么？"}}
        tool(["执行工具，返回结果<br/>（zoom 返回放大的图像）"])
        check{{"baseline 检查：<br/>答案合格吗？"}}
        again{{"第一次停下？"}}
        remind(["提醒一次调用 answer，<br/>已做的工作保留"])
        grace(["最后一轮：<br/>只剩 answer 工具"])
        saved(["保存 answer.json，<br/>结束会话"])
        noanswer(["没有答案，结束"])
        turn --> what
        what -- "调用 zoom、bash、<br/>read 或 write" --> tool
        what -- "调用 answer" --> check
        what -- "没调用 answer<br/>就停下" --> again
        what -- "用满 25 轮" --> grace
        check -- "合格" --> saved
        again -- "是" --> remind
        again -- "否" --> noanswer
        grace -- "答案合格" --> saved
        grace -- "仍无合格答案" --> noanswer
        tool -.-> turn
        remind -.-> turn
        check -. "不合格：返回原因<br/>（空答案拒绝一次）" .-> turn
    end

    timeout(["超过 30 分钟：<br/>主机停止容器"])
    turn -. "任何时候" .-> timeout
    hostcheck(["主机用 baseline 检查<br/>再次校验 answer.json"])
    saved --> hostcheck
    noanswer --> hostcheck
    timeout --> hostcheck
    hostcheck --> record(["保存本题记录"])

    classDef base fill:#fefce8,stroke:#ca8a04,color:#422006
    classDef usesBase fill:#eef2ff,stroke:#ca8a04,color:#1e1b4b,stroke-width:2px,stroke-dasharray:4 3
    classDef ours fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
    classDef agent fill:#ecfdf5,stroke:#10b981,color:#064e3b
    classDef bad fill:#fef2f2,stroke:#ef4444,color:#7f1d1d
    class check base
    class hostcheck usesBase
    class record ours
    class turn,what,tool,again,remind,grace,saved agent
    class timeout,noanswer bad
    style SESSION fill:#f8fafc,stroke:#10b981,stroke-width:2px,stroke-dasharray:6 4
